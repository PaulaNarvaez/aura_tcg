# Sin estas variables, la tienda usa el catálogo de muestra.
# Copia este archivo como .env.local y completa ambos valores para usar Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Usa una clave pública sb_publishable_... (o la antigua anon).
# Nunca coloques una clave secret/service_role en variables VITE_.
