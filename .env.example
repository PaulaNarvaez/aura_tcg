# Copia este archivo como .env.local para conectar el catálogo a Neon.
# La conexión es privada: úsala solo en el servidor, nunca en una variable VITE_.
DATABASE_URL=

# La página consulta nuestra API; no accede directamente a PostgreSQL.
# Sin esta variable, usa el catálogo de muestra.
VITE_CATALOG_API_URL=/api/products
